# Shell 脚本在 Linux 上执行，必须保持 LF。
# 如果被转成 CRLF，会出现 "bad interpreter: /bin/bash^M" 这种诡异报错。
*.sh       text eol=lf
*.bash     text eol=lf
install.sh text eol=lf

# 文档和配置用 LF 即可
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
